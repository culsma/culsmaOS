let p=plate(label="Assay",format="96well",capacity=200uL);
let wells=p[A1];
let stock=tube(label="Stock",capacity=2000uL,load=[content(kind = formulation, type = buffer, code = "BUFFER"):100uL]);
wells[0] << [stock:50uL];
with env(thermal=37C,duration=1s) { hold(sample=wells); }
stock << [wells[0]:20uL];
return wells[0];
