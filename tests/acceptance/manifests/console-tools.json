      "tools": [
        "read_document",
        "create_document",
        "save_document",
        "receive_files"
      ]
    },
    {
      "route": "/api/v1/configuration/profiles",
      "tools": [
        "configuration_profiles"
      ]
    },
    {
      "route": "/api/v1/configuration/drafts",
      "tools": [
        "configuration_profiles",
        "list_configurations",
        "read_configuration",
        "create_configuration",
        "save_configuration",
        "validate_configuration",
        "export_configuration",
        "export_vendor_layout"
      ]
    },
    {
      "route": "/api/v1/configuration/layout-import",
