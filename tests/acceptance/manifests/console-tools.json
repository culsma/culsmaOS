        "configuration_status"
      ]
    },
    {
      "route": "/api/v1/configuration/activation",
      "tools": [
        "configuration_status",
        "apply_configuration"
      ]
    },
    {
      "route": "/api/v1/configuration/labware",
      "tools": [
        "labware_catalogue",
        "prepare_labware_change"
      ]
    },
    {
      "route": "/api/v1/setup",
      "tools": [
        "loading_plan",
        "revise_loading_plan",
        "begin_loading",
        "loading_request_status"
      ]
    },
    {
      "route": "/api/v1/consumables",
      "tools": [
        "tip_supply",
        "replace_simulated_tip_box",
        "tip_replacement_status"
      ]
    },
    {
      "route": "/api/v1/developer/fault-test",
      "tools": [
        "test_device_fault"
      ]
    },
    {
      "route": "/api/v1/console/views/read",
      "tools": [
        "view_state",
        "view_request_status"
      ]
    },
    {
      "route": "/api/v1/console/views/request",
      "tools": [
        "open_view",
        "reveal_entity"
      ]
    },
    {
      "route": "/api/v1/setup/confirmation",
      "exception": "operator_only",
      "reason": "A person confirms physical loading; automation cannot assert inspection."
    },
    {
      "route": "/api/v1/console/renderer",
      "exception": "renderer_only",
      "reason": "Only the native renderer may report its own presentation state."
    },
    {
      "route": "/api/v1/session",
      "exception": "process_bootstrap",
      "reason": "Session credentials are issued privately by the application lifecycle."
    },
    {
      "route": "/api/v1/instrument-profiles",
      "tools": [
        "instrument_profile_catalogue",
        "list_instrument_profiles",
        "read_instrument_profile",
        "validate_instrument_profile",
        "save_instrument_profile"
      ]
