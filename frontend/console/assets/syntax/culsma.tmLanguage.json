{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Culsma",
  "scopeName": "source.labword",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#special-forms"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#quantities"
    },
    {
      "include": "#mutation"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#types-and-builtins"
    },
    {
      "include": "#members"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.labword",
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.labword"
            }
          },
          "end": "$\n?"
        },
        {
          "name": "comment.block.labword",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.labword"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.labword"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.labword",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.labword"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.labword"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.labword",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.labword",
          "match": "\\b(protocol|include|import|returns|let|repeat|in|if|else|break|continue|return|with|env|constraint|and|or)\\b"
        }
      ]
    },
    "special-forms": {
      "patterns": [
        {
          "name": "support.function.builtin.labword",
          "match": "\\b(series|group|markers)\\b(?=\\s*\\()"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.labword",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "quantities": {
      "patterns": [
        {
          "name": "constant.numeric.quantity.labword",
          "match": "(?<![A-Za-z0-9_])(?:\\d+(?:\\.\\d+)?(?:ng_per_uL|ug_per_mL|cells|day|sec|rpm|rcf|pct|min|mL|ml|uL|ul|mM|uM|nM|nm|mW|mV|mg|ug|kg|um|hr|Hz|xg|ms|L|g|s|h|C|K|M|W|V|X|%)(?![A-Za-z0-9_])|\\d+(?:\\.\\d+)?)"
        }
      ]
    },
    "mutation": {
      "patterns": [
        {
          "name": "keyword.operator.mutation.labword",
          "match": "<<"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.labword",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.labword",
          "match": "="
        },
        {
          "name": "keyword.operator.arithmetic.labword",
          "match": "\\+|-|\\*|/"
        }
      ]
    },
    "types-and-builtins": {
      "patterns": [
        {
          "name": "support.function.labword",
          "match": "\\b(container|tube|well|plate|chamber|surface|content|blood|reagent|buffer|stream|data_ref|data_group_ref|data_schema|sep|frac|img|ecp|phy|agit|schedule|hold)\\b(?=\\s*\\()"
        },
        {
          "name": "support.function.program.labword",
          "match": "\\b(thermal_program|centrifuge_program|magnetic_program|disrupt_program|field_program|filtration_program|centrifugal_filtration_program|phase_partition_program|precipitation_program|density_gradient_program|chromatography_program)\\b(?=\\s*\\()"
        },
        {
          "name": "constant.language.symbol.labword",
          "match": "\\b(single_cell|molecule|ion|positive|negative|neutral|charged|temperature|pressure|flow_rate|mass|volume|humidity|current|fluorescence|uv_absorbance|colorimetric|ph|conductivity|dissolved_oxygen|orp|customized)\\b"
        }
      ]
    },
    "members": {
      "patterns": [
        {
          "name": "variable.other.member.labword",
          "match": "(?<=\\.)\\b(result|items|marker|mark|obs|records|sequence|signal|current_pulse|arrival_time|intensity|mz|schema_ref|subject_ref|context_ref|contents|structure|top|bottom|sidewall)\\b"
        },
        {
          "name": "entity.name.function.member.labword",
          "match": "(?<=\\.)\\b(append|detects|partition)\\b(?=\\s*\\()"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.labword",
          "match": "\\b[A-Za-z][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
